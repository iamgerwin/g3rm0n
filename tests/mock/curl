#!/usr/bin/env bash
# Mock curl for tests: canned, synthetic responses for every AI provider endpoint.
# Mirrors how ai_get calls curl: headers on stdin (-H @-), response headers first
# when asked for (-D -), then the body and "\n<status>" (-w \n%{http_code}).
# Bearer tokens pick a scenario: "bad" -> 401, "ratelimited" -> 429 with
# Retry-After: 1800, "ratelimited-noheader" -> 429 without one. Set G3_MOCK_LOG to a
# file to record one line per API request. Never put real data in here.
# Release lookups (install.sh): G3_MOCK_GITHUB=ok (default) | noredirect | down
headers=""
[[ " $* " == *" -H @- "* ]] && headers=$(cat)
url=""
for a in "$@"; do [[ $a == https://* ]] && url=$a; done
case $url in
  https://github.com/*/releases/latest)
    case ${G3_MOCK_GITHUB:-ok} in
      ok) printf 'https://github.com/iamgerwin/g3rm0n/releases/tag/v9.8.7' ;;
      noredirect) printf '%s' "$url" ;;
      down) echo "curl: (22) The requested URL returned error: 503" >&2; exit 22 ;;
    esac
    exit 0 ;;
  https://api.github.com/*/releases/latest)
    case ${G3_MOCK_GITHUB:-ok} in
      down) echo "curl: (56) The requested URL returned error: 403" >&2; exit 56 ;;
      *) printf '{\n  "tag_name": "v9.8.6",\n  "name": "g3rm0n v9.8.6"\n}\n' ;;
    esac
    exit 0 ;;
esac

dump=0; [[ " $* " == *" -D - "* ]] && dump=1
reply() { # status body [header-line] : what curl prints with -D - and -w '\n%{http_code}'
  [[ -n ${G3_MOCK_LOG:-} ]] && printf '%s %s\n' "$1" "$url" >>"$G3_MOCK_LOG"
  if (( dump )); then
    printf 'HTTP/2 %s\r\ncontent-type: application/json\r\n' "$1"
    [[ -n ${3:-} ]] && printf '%s\r\n' "$3"
    printf '\r\n'
  fi
  printf '%s\n%s' "$2" "$1"
  exit 0
}
[[ $headers == *"Bearer bad"* ]] && reply 401 '{"error":"unauthorized"}'
[[ $headers == *"Bearer ratelimited-noheader"* ]] && reply 429 '{"error":{"type":"rate_limit_error"}}'
[[ $headers == *"Bearer ratelimited"* ]] && reply 429 '{"error":{"type":"rate_limit_error"}}' 'retry-after: 1800'

# shellcheck source=tests/lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
now=$(date +%s)
case $url in
  *api.anthropic.com/api/oauth/usage)
    body='{"five_hour":{"utilization":42.0,"resets_at":"'$(iso_utc $((now + 7200)))'.123456+00:00"},
           "seven_day":{"utilization":17.0,"resets_at":"'$(iso_utc $((now + 259200)))'Z"}}' ;;
  *chatgpt.com/backend-api/wham/usage)
    body='{"plan_type":"plus","rate_limit":{
           "primary_window":{"used_percent":12,"limit_window_seconds":18000,"reset_at":'$((now + 9000))'},
           "secondary_window":{"used_percent":3,"limit_window_seconds":604800,"reset_at":'$((now + 500000))'}}}' ;;
  *api.z.ai/api/monitor/usage/quota/limit)
    body='{"code":200,"data":{"level":"lite","limits":[
           {"type":"TOKENS_LIMIT","unit":3,"percentage":64,"nextResetTime":'$(( (now + 3600) * 1000 ))'},
           {"type":"TIME_LIMIT","unit":5,"percentage":10,"nextResetTime":'$(( (now + 864000) * 1000 ))'}]}}' ;;
  *api.deepseek.com/user/balance)
    body='{"is_available":true,"balance_infos":[{"currency":"CNY","total_balance":"110.00",
           "granted_balance":"10.00","topped_up_balance":"100.00"}]}' ;;
  *openrouter.ai/api/v1/key)
    body='{"data":{"label":"sk-or-v1-placeholder","limit":null,"limit_remaining":null,"usage":12.5,
           "usage_daily":0.42,"usage_weekly":3.1,"usage_monthly":12.5,"is_free_tier":false}}' ;;
  *openrouter.ai/api/v1/credits)
    body='{"data":{"total_credits":25,"total_usage":16.8}}' ;;
  *) reply 404 '{}' ;;
esac
reply 200 "$body"
