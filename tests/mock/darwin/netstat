#!/usr/bin/env bash
# counters grow at about 2 MB/s down and 0.5 MB/s up, so rates are never zero
t=${EPOCHREALTIME/./}; rx=$(( 1200000000 + t * 2 )); tx=$(( 300000000 + t / 2 ))
printf '%-10s %-5s %-13s %-17s %8s %5s %12s %8s %5s %12s %5s\n' \
  Name Mtu Network Address Ipkts Ierrs Ibytes Opkts Oerrs Obytes Coll \
  lo0 16384 '<Link#1>' '' 5000 0 1000000 5000 0 1000000 0 \
  lo0 16384 127 127.0.0.1 5000 - 1000000 5000 - 1000000 - \
  en0 1500 '<Link#11>' aa:bb:cc:dd:ee:ff 900000 0 "$rx" 500000 0 "$tx" 0 \
  en0 1500 192.168.1 192.168.1.24 900000 - "$rx" 500000 - "$tx" - \
  utun4 1280 '<Link#20>' '' 100 0 50000 100 0 40000 0 | sed 's/   */  /g'
