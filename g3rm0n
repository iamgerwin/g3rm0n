#!/usr/bin/env bash
# g3rm0n — a live terminal dashboard for your Linux machine and your AI usage
set -o pipefail

if (( BASH_VERSINFO[0] < 5 )); then
  echo "g3rm0n needs bash 5 or newer (found $BASH_VERSION)" >&2
  exit 1
fi
if [[ $(uname -s) != Linux ]]; then
  echo "g3rm0n reads /proc and /sys, so it runs on Linux only" >&2
  exit 1
fi
# panel widths count characters, which needs a UTF-8 locale
[[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *[Uu][Tt][Ff]-8* || ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *[Uu][Tt][Ff]8* ]] \
  || export LC_ALL=C.UTF-8

G3_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
for _m in core ui system ai dashboard setup; do
  # shellcheck source=/dev/null
  source "$G3_HOME/lib/$_m.sh"
done
unset _m

usage() {
  cat <<EOF
${c_bold}g3rm0n${c_off} v$G3_VERSION — live terminal dashboard for your machine and your AI usage

${c_bold}Usage${c_off}
  g3rm0n [options]          open the live dashboard (q quits, any key refreshes)
  g3rm0n setup [option]     choose sections and AI providers (see: g3rm0n setup --help)
  g3rm0n version            print the version
  g3rm0n help               show this help

${c_bold}Options${c_off}
  -1, --once                print one snapshot and exit (default when not a terminal)
  -i, --interval N          seconds between refreshes (default: from config, else 2)
  -s, --sections LIST       override sections for this run, e.g. cpu,memory,ai-tokens
      --no-ai               hide AI panels and make no network calls
      --no-color            plain output (NO_COLOR is honoured too)

${c_bold}Sections${c_off}
  ${G3_SECTIONS[*]}

${c_bold}Files${c_off}
  config   $G3_CONFIG_FILE
  cache    $G3_CACHE_DIR   (usage numbers only, never credentials)
EOF
}

main() {
  local once=0 interval="" sections=""
  case ${1:-} in
    setup)   g3_colors; shift; setup_run "$@"; return ;;
    version|-V|--version) printf 'g3rm0n %s\n' "$G3_VERSION"; return ;;
    help|-h|--help) g3_colors; usage; return ;;
  esac
  while (( $# )); do
    case $1 in
      -1|--once) once=1 ;;
      -i|--interval) shift; interval=${1:-} ;;
      --interval=*) interval=${1#*=} ;;
      -s|--sections) shift; sections=${1:-} ;;
      --sections=*) sections=${1#*=} ;;
      --no-ai) G3_NO_AI=1 ;;
      --no-color) G3_NO_COLOR=1 ;;
      *) g3_colors; printf 'g3rm0n: unknown option %s\n\n' "$1" >&2; usage >&2; return 2 ;;
    esac
    shift
  done
  g3_colors
  g3_config_load
  [[ -n $sections ]] && CFG[sections]=${sections//,/ }
  [[ -n $interval ]] && CFG[interval]=$interval
  interval=${CFG[interval]}
  [[ $interval =~ ^[1-9][0-9]*$ ]] || die "interval must be a whole number of seconds, got '$interval'"
  [[ -t 0 && -t 1 ]] || once=1
  dash_run "$once" "$interval"
}

main "$@"
