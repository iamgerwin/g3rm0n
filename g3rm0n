#!/usr/bin/env bash
# g3rm0n — a live terminal dashboard for your machine (Linux, macOS) and your AI usage

# g3rm0n needs bash 5. Started from sh/dash/zsh/ksh, or by macOS's own bash 3.2? Find a
# bash 5 (the one on PATH, then where Homebrew and distributions put it) and hand over
# before any bash 5 syntax is parsed. This block must stay POSIX (and zsh-safe).
# (bash started as sh runs in POSIX mode, which g3rm0n doesn't support: hand over too)
if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSION%%.*}" -lt 5 ] \
   || case ":${SHELLOPTS:-}:" in *:posix:*) true ;; *) false ;; esac; then
  if [ -z "${G3_REEXEC:-}" ]; then
    # an explicit list, because zsh doesn't word-split an unquoted $PATH
    for _b in "$(command -v bash 2>/dev/null)" /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash /bin/bash; do
      # shellcheck disable=SC2016  # the candidate bash expands it, not this shell
      if [ -x "$_b" ] && "$_b" -c '[ "${BASH_VERSION%%.*}" -ge 5 ]' 2>/dev/null; then
        export G3_REEXEC=1
        exec "$_b" "$0" "$@"
      fi
    done
  fi
  echo "g3rm0n needs bash 5 or newer (found ${BASH_VERSION:-no bash})." >&2
  [ "$(uname -s)" = Darwin ] && echo "Install it with Homebrew: brew install bash" >&2
  exit 1
fi
unset G3_REEXEC
set -o pipefail

# G3_PLATFORM may be preset only by the test suite, to run a backend against fixtures
case ${G3_PLATFORM:-$(uname -s)} in
  Linux|linux)   G3_PLATFORM=linux ;;
  Darwin|darwin) G3_PLATFORM=darwin ;;
  *) echo "g3rm0n runs on Linux and macOS (this system is $(uname -s))" >&2; exit 1 ;;
esac
# Locale: panel widths count characters, so the character set must be UTF-8 (macOS
# has no C.UTF-8). Numbers must use "." in every locale: bash's EPOCHREALTIME, printf
# and read -t, and awk in the backends, all follow LC_NUMERIC, and a "," (German,
# French, Dutch, ...) breaks timing and money. Keep the user's character set, take
# numbers from C, for g3rm0n and every tool it runs.
_ctype=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
if [[ $_ctype != *[Uu][Tt][Ff]?(-)8* ]]; then
  if [[ $G3_PLATFORM == darwin ]]; then _ctype=en_US.UTF-8; else _ctype=C.UTF-8; fi
fi
unset LC_ALL
export LC_CTYPE=$_ctype LC_NUMERIC=C
unset _ctype

# where g3rm0n lives, following symlinks (readlink -f isn't on every macOS)
_src=${BASH_SOURCE[0]}
while [[ -L $_src ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  [[ $_src == /* ]] || _src=$_dir/$_src
done
G3_HOME=$(cd -P "$(dirname "$_src")" && pwd)
unset _src _dir
if [[ ! -r $G3_HOME/lib/platform/$G3_PLATFORM.sh ]]; then
  echo "g3rm0n: this installation has no $G3_PLATFORM support; reinstall it on this machine" >&2
  exit 1
fi
for _m in core ui panel fold input keymap "platform/$G3_PLATFORM" system ai dashboard setup; do
  # shellcheck source=/dev/null
  source "$G3_HOME/lib/$_m.sh"
done
unset _m

usage() {
  cat <<EOF
${c_bold}g3rm0n${c_off} v$G3_VERSION — live terminal dashboard for your machine and your AI usage

${c_bold}Usage${c_off}
  g3rm0n [options]          open the live dashboard (see Keys below)
  g3rm0n setup [option]     choose sections and AI providers (see: g3rm0n setup --help)
  g3rm0n sensors            list the temperature sensors g3rm0n can read
  g3rm0n version            print the version
  g3rm0n help               show this help

${c_bold}Options${c_off}
  -1, --once                print one snapshot and exit (default when not a terminal)
  -i, --interval N          seconds between refreshes (default: from config, else 2)
  -s, --sections LIST       override sections for this run, e.g. cpu,memory,ai-tokens
  -f, --fold LIST           start with these folded: sections, panel ids, all or none
      --no-mouse            don't capture the mouse (keeps the terminal's own selection)
      --no-ai               hide AI panels and make no network calls
      --no-color            plain output (NO_COLOR is honoured too)

${c_bold}Sections${c_off}
  ${G3_SECTIONS[*]}

${c_bold}Keys${c_off} (live dashboard)
$(for _k in "${KEYMAP_HELP[@]}"; do printf '  %-12s %s\n' "${_k%%|*}" "${_k#*|}"; done)

${c_bold}Files${c_off}
  config   $G3_CONFIG_FILE
  cache    $G3_CACHE_DIR   (usage numbers only, never credentials)
  state    $G3_STATE_DIR   (which panels are folded)
EOF
}

main() {
  local once=0 interval="" sections="" fold=""
  case ${1:-} in
    setup)   g3_colors; shift; setup_run "$@"; return ;;
    version|-V|--version) printf 'g3rm0n %s\n' "$G3_VERSION"; return ;;
    sensors) g3_colors; sys_sensors_report; return ;;
    help|-h|--help) g3_colors; usage; return ;;
  esac
  while (( $# )); do
    case $1 in
      -1|--once) once=1 ;;
      -i|--interval) shift; interval=${1:-} ;;
      --interval=*) interval=${1#*=} ;;
      -s|--sections) shift; sections=${1:-} ;;
      --sections=*) sections=${1#*=} ;;
      -f|--fold) shift; fold=${1:-none} ;;
      --fold=*) fold=${1#*=} ;;
      --no-mouse) G3_NO_MOUSE=1 ;;
      --no-ai) G3_NO_AI=1 ;;
      --no-color) G3_NO_COLOR=1 ;;
      *) g3_colors; printf 'g3rm0n: unknown option %s\n\n' "$1" >&2; usage >&2; return 2 ;;
    esac
    shift
  done
  g3_colors
  g3_config_load
  [[ -n $sections ]] && CFG[sections]=${sections//,/ }
  [[ -n $interval ]] && CFG[interval]=$interval
  interval=${CFG[interval]}
  [[ $interval =~ ^[1-9][0-9]*$ ]] || die "interval must be a whole number of seconds, got '$interval'"
  [[ -t 0 && -t 1 ]] || once=1
  dash_run "$once" "$interval" "$fold"
}

# "exit" on the same line: bash reads a script while running it, so if this file is
# replaced or edited while g3rm0n runs (an update, a git pull), nothing after main
# may ever be read from the new contents.
main "$@"; exit
